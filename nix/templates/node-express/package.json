{
  "name": "express-app",
  "version": "0.1.0",
  "description": "Express API template",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.19.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
